{
  "name": "ecommerce-usability-simulator-server",
  "version": "1.0.0",
  "description": "Backend API for E-Commerce Usability Simulator",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-participants": "tsx prisma/seed-participants.ts",
